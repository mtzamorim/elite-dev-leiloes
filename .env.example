# Copie para .env e substitua os segredos antes de publicar.
DATABASE_URL=postgresql://atelier:atelier_local@localhost:5432/atelier?schema=public
PORT=3001
NODE_ENV=development
JWT_SECRET=CHANGE_THIS_JWT_SECRET_TO_A_RANDOM_STRING_WITH_AT_LEAST_32_CHARACTERS
AUDIT_SECRET=CHANGE_THIS_AUDIT_SECRET_TO_A_DIFFERENT_RANDOM_STRING_WITH_AT_LEAST_32_CHARACTERS
AUDIT_ANCHOR_FILE=./storage/audit-anchors.ndjson
DEMO_SEED=true
