{
  "name": "atelier-leiloes",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c cyan,magenta \"npm run dev -w @atelier/api\" \"npm run dev -w @atelier/web\"",
    "build": "npm run db:generate && npm run build -w @atelier/web",
    "start": "npm run start -w @atelier/api",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "db:dev": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "db:seed": "node apps/api/prisma/seed.js",
    "test": "node --test apps/api/tests/domain.test.js apps/api/tests/audit.test.js",
    "test:all": "npm test && npm run test:api && npm run test:web",
    "test:api": "node --test apps/api/tests/*.integration.test.js",
    "test:web": "vitest run --config apps/web/vite.config.ts",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit",
    "lint:syntax": "node scripts/check-syntax.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "concurrently": "9.1.2",
    "prisma": "6.19.0",
    "typescript": "5.8.3",
    "vitest": "3.1.1",
    "@playwright/test": "1.55.0"
  },
  "engines": {
    "node": ">=20.11"
  }
}
